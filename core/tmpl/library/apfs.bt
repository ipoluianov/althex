//! name: APFS container
//! extensions: apfs
//! magic: 0x20 "4E 58 53 42"

// Apple File System: the container superblock (nx_superblock_t) in block
// 0. It is a copy: the newest one is in the checkpoint descriptor area
// (nx_xp_desc_base). The Fletcher-64 checksum (o_cksum) is not verified.

LittleEndian();

string ObjTypeComment(uint32 &t) {
    local string s = "";
    switch (t & 0xFFFF) {
    case 0x01: s = "NX_SUPERBLOCK"; break;
    case 0x02: s = "BTREE"; break;
    case 0x03: s = "BTREE_NODE"; break;
    case 0x05: s = "SPACEMAN"; break;
    case 0x0B: s = "OMAP"; break;
    case 0x0C: s = "CHECKPOINT_MAP"; break;
    case 0x0D: s = "FS"; break;
    }
    if (t & 0x80000000) s += " virtual";
    if (t & 0x40000000) s += " ephemeral";
    if (t & 0x20000000) s += " noheader";
    if (t & 0x10000000) s += " encrypted";
    return s;
}

struct OBJ_PHYS {
    uint64 o_cksum <format=hex, comment="Fletcher-64 of the rest of the block">;
    uint64 o_oid;
    uint64 o_xid <comment="the transaction">;
    uint32 o_type <format=hex, comment=ObjTypeComment>;
    uint32 o_subtype <format=hex>;
};

struct APFS_UUID {
    uchar b[16];
} <read=UUIDRead>;

string UUIDRead(APFS_UUID &u) {
    local int64 p = startof(u);
    local string s = "";
    local int i;
    for (i = 0; i < 16; i++) {
        if (i == 4 || i == 6 || i == 8 || i == 10)
            s += "-";
        s += Str("%02X", ReadUByte(p + i));
    }
    return s;
}

struct PRANGE {
    uint64 pr_start_paddr;
    uint64 pr_block_count;
};

string FeaturesComment(uint64 &f) {
    local string s = "";
    if (f & 1) s += "defrag ";
    if (f & 2) s += "lcfd ";
    return s;
}

string IncompatComment(uint64 &f) {
    local string s = "";
    if (f & 1) s += "version1 ";
    if (f & 2) s += "version2 ";
    if (f & 0x100) s += "fusion ";
    return s;
}

string XpComment(uint32 &v) {
    if (v & 0x80000000)
        return "the area is a B-tree (the high bit)";
    return "blocks";
}

struct NX_SUPERBLOCK {
    OBJ_PHYS nx_o;
    char     nx_magic[4] <comment="NXSB">;
    uint32   nx_block_size;
    uint64   nx_block_count;
    uint64   nx_features <format=hex, comment=FeaturesComment>;
    uint64   nx_readonly_compatible_features <format=hex>;
    uint64   nx_incompatible_features <format=hex, comment=IncompatComment>;
    APFS_UUID nx_uuid;
    uint64   nx_next_oid;
    uint64   nx_next_xid;
    uint32   nx_xp_desc_blocks <comment=XpComment>;
    uint32   nx_xp_data_blocks <comment=XpComment>;
    uint64   nx_xp_desc_base <comment="the checkpoint descriptor area">;
    uint64   nx_xp_data_base;
    uint32   nx_xp_desc_next;
    uint32   nx_xp_data_next;
    uint32   nx_xp_desc_index;
    uint32   nx_xp_desc_len;
    uint32   nx_xp_data_index;
    uint32   nx_xp_data_len;
    uint64   nx_spaceman_oid;
    uint64   nx_omap_oid <comment="the object map of the container (physical)">;
    uint64   nx_reaper_oid;
    uint32   nx_test_type;
    uint32   nx_max_file_systems;
    uint64   nx_fs_oid[100] <comment="the volumes (virtual object IDs)">;
    uint64   nx_counters[32];
    PRANGE   nx_blocked_out_prange;
    uint64   nx_evict_mapping_tree_oid;
    uint64   nx_flags <format=hex, comment="2 - crypto software">;
    uint64   nx_efi_jumpstart;
    APFS_UUID nx_fusion_uuid;
    PRANGE   nx_keylocker;
    uint64   nx_ephemeral_info[4];
    uint64   nx_test_oid;
    uint64   nx_fusion_mt_oid;
    uint64   nx_fusion_wbc_oid;
    PRANGE   nx_fusion_wbc;
    uint64   nx_newest_mounted_version;
    PRANGE   nx_mkb_locker;
};

if (FileSize() < 0x580) {
    Warning("the container superblock is cut");
    Exit(0);
}
NX_SUPERBLOCK superblock <open=true>;

// The volumes in use
local int i, volumes = 0;
for (i = 0; i < 100; i++)
    if (superblock.nx_fs_oid[i] != 0)
        volumes++;
Printf("%d volumes, block size %u\n", volumes, superblock.nx_block_size);
