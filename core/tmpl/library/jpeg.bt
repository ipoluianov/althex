//! name: JPEG image
//! extensions: jpg, jpeg, jpe, jfif
//! magic: 0 "FF D8 FF"

// JPEG (ITU-T T.81 / ISO/IEC 10918-1) with JFIF and Exif: a sequence of
// segments, each starting with a marker FF xx. Most have a 16-bit length
// (which counts itself); SOS is followed by the entropy-coded data, which
// runs to the next marker that is not FF 00 (a stuffed FF) or RST0..RST7.
// The markers and lengths are big-endian; the Exif TIFF data has its own
// byte order.

BigEndian();

enum <uint16> JPEG_MARKER {
    TEM  = 0xFF01,
    SOF0 = 0xFFC0, SOF1, SOF2, SOF3, DHT, SOF5, SOF6, SOF7,
    JPG, SOF9, SOF10, SOF11, DAC, SOF13, SOF14, SOF15,
    RST0 = 0xFFD0, RST1, RST2, RST3, RST4, RST5, RST6, RST7,
    SOI = 0xFFD8, EOI, SOS, DQT, DNL, DRI, DHP, EXP,
    APP0 = 0xFFE0, APP1, APP2, APP3, APP4, APP5, APP6, APP7,
    APP8, APP9, APP10, APP11, APP12, APP13, APP14, APP15,
    JPG0 = 0xFFF0, JPG1, JPG2, JPG3, JPG4, JPG5, JPG6, JPG7,
    JPG8, JPG9, JPG10, JPG11, JPG12, JPG13, COM = 0xFFFE
};

enum <uchar> JFIF_UNITS { NO_UNITS = 0, DOTS_PER_INCH = 1, DOTS_PER_CM = 2 };

enum <uint16> TIFF_TYPE {
    BYTE = 1, ASCII, SHORT, LONG, RATIONAL, SBYTE, UNDEFINED, SSHORT, SLONG,
    SRATIONAL, FLOAT, DOUBLE, IFD = 13
};

enum <uint16> EXIF_TAG {
    ImageWidth = 0x0100, ImageLength = 0x0101, BitsPerSample = 0x0102,
    Compression = 0x0103, PhotometricInterpretation = 0x0106,
    ImageDescription = 0x010E, Make = 0x010F, Model = 0x0110,
    StripOffsets = 0x0111, Orientation = 0x0112, SamplesPerPixel = 0x0115,
    RowsPerStrip = 0x0116, StripByteCounts = 0x0117, XResolution = 0x011A,
    YResolution = 0x011B, PlanarConfiguration = 0x011C, ResolutionUnit = 0x0128,
    TransferFunction = 0x012D, Software = 0x0131, DateTime = 0x0132,
    Artist = 0x013B, WhitePoint = 0x013E, PrimaryChromaticities = 0x013F,
    JPEGInterchangeFormat = 0x0201, JPEGInterchangeFormatLength = 0x0202,
    YCbCrCoefficients = 0x0211, YCbCrSubSampling = 0x0212,
    YCbCrPositioning = 0x0213, ReferenceBlackWhite = 0x0214,
    Copyright = 0x8298, ExposureTime = 0x829A, FNumber = 0x829D,
    ExifIFDPointer = 0x8769, ExposureProgram = 0x8822,
    GPSInfoIFDPointer = 0x8825, ISOSpeedRatings = 0x8827,
    ExifVersion = 0x9000, DateTimeOriginal = 0x9003, DateTimeDigitized = 0x9004,
    ComponentsConfiguration = 0x9101, ShutterSpeedValue = 0x9201,
    ApertureValue = 0x9202, BrightnessValue = 0x9203,
    ExposureBiasValue = 0x9204, MaxApertureValue = 0x9205,
    MeteringMode = 0x9207, Flash = 0x9209, FocalLength = 0x920A,
    MakerNote = 0x927C, UserComment = 0x9286, SubSecTime = 0x9290,
    FlashpixVersion = 0xA000, ColorSpace = 0xA001,
    PixelXDimension = 0xA002, PixelYDimension = 0xA003,
    InteroperabilityIFDPointer = 0xA005, ExposureMode = 0xA402,
    WhiteBalance = 0xA403, DigitalZoomRatio = 0xA404,
    FocalLengthIn35mmFilm = 0xA405, SceneCaptureType = 0xA406,
    LensModel = 0xA434
};

// The bytes of one value of a TIFF type
int TiffTypeSize(int type) {
    switch (type) {
    case 1: case 2: case 6: case 7: return 1;
    case 3: case 8: return 2;
    case 4: case 9: case 11: case 13: return 4;
    case 5: case 10: case 12: return 8;
    }
    return 1;
}

struct TIFF_RATIONAL {
    uint32 numerator;
    uint32 denominator;
} <read=RationalRead>;

string RationalRead(TIFF_RATIONAL &r) {
    return Str("%u/%u", r.numerator, r.denominator);
}

// An entry of an IFD: the value is in the entry when it takes 4 bytes or
// less, otherwise at an offset from the TIFF header
struct IFD_ENTRY(int64 tiffStart, int64 tiffEnd) {
    EXIF_TAG  tag <format=hex>;
    TIFF_TYPE type;
    uint32    count;
    local int64 size = TiffTypeSize(type) * (int64)count;
    if (size <= 4) {
        if (type == ASCII && count > 0)
            char value[count];
        else if ((type == SHORT || type == SSHORT) && count == 1)
            uint16 value;
        else if ((type == SHORT || type == SSHORT) && count == 2)
            uint16 value[2];
        else if ((type == LONG || type == SLONG || type == IFD) && count == 1)
            uint32 value;
        else if (count > 0)
            uchar value[size];
        if (FTell() < startof(tag) + 12)
            uchar padding[startof(tag) + 12 - FTell()];
    } else {
        uint32 valueOffset <format=hex, comment="from the start of the TIFF header">;
        local int64 at = tiffStart + valueOffset;
        if (valueOffset >= 8 && at + size <= tiffEnd) {
            if (type == ASCII)
                char value[count] @ at;
            else if ((type == RATIONAL || type == SRATIONAL) && count == 1)
                TIFF_RATIONAL value @ at;
            else if ((type == SHORT || type == SSHORT) && count <= 64)
                uint16 value[count] @ at;
            else if ((type == LONG || type == SLONG) && count <= 64)
                uint32 value[count] @ at;
            else
                uchar value[size] @ at;
        }
    }
};

string IFDEntryRead(IFD_ENTRY &e) {
    local string name = EnumToString(e.tag);
    if (name == "")
        name = Str("0x%04X", e.tag);
    if (exists(e.value))
        return name + " = " + Str("%s", e.value);
    return name;
}

// An image file directory: count, entries, the offset of the next one
struct IFD(int64 tiffStart, int64 tiffEnd) {
    uint16 count;
    local int n = count;
    if (n > (tiffEnd - FTell()) / 12)
        n = (tiffEnd - FTell()) / 12;   // a damaged count
    local int i;
    for (i = 0; i < n; i++)
        IFD_ENTRY entry(tiffStart, tiffEnd) <read=IFDEntryRead>;
    if (tiffEnd - FTell() >= 4)
        uint32 nextIFDOffset <format=hex>;
};

// The offset of the sub-IFD the tag points to in the IFD, 0 if none
int64 SubIFDOffset(int64 ifdStart, int64 tiffEnd, int tag) {
    local int n = ReadUShort(ifdStart);
    local int i;
    local int64 p;
    for (i = 0; i < n && i < 1000; i++) {
        p = ifdStart + 2 + i * 12;
        if (p + 12 > tiffEnd)
            break;
        if (ReadUShort(p) == tag)
            return ReadUInt(p + 8);
    }
    return 0;
}

// Exif in APP1: "Exif" 00 00, then a TIFF header and IFD0, IFD1, the
// Exif sub-IFD
struct EXIF(int64 end) {
    char identifier[6] <comment="\"Exif\" 00 00">;
    local int64 tiffStart = FTell();
    if (end - tiffStart >= 8) {
        char byteOrder[2] <comment="II - little-endian, MM - big-endian">;
        if (ReadUShort(tiffStart) == 0x4949)
            LittleEndian();
        else
            BigEndian();
        uint16 magic <comment="42">;
        uint32 ifd0Offset <format=hex, comment="from the start of the TIFF header">;
        local int64 off = ifd0Offset;
        local int64 sub = 0;
        if (off >= 8 && tiffStart + off + 2 <= end) {
            IFD ifd0(tiffStart, end) @ tiffStart + off;
            sub = SubIFDOffset(tiffStart + off, end, 0x8769);
            if (exists(ifd0.nextIFDOffset) && ifd0.nextIFDOffset >= 8 && ifd0.nextIFDOffset != off
                    && tiffStart + ifd0.nextIFDOffset + 2 <= end)
                IFD ifd1(tiffStart, end) @ tiffStart + ifd0.nextIFDOffset;
            if (sub >= 8 && sub != off && tiffStart + sub + 2 <= end)
                IFD exifIFD(tiffStart, end) @ tiffStart + sub;
        }
        BigEndian();
    }
    // The placed fields do not move the position: the rest of the segment
    // is taken by the caller
};

struct SOF_COMPONENT {
    uchar componentId <comment="1 - Y, 2 - Cb, 3 - Cr in JFIF">;
    uchar horizontalSampling : 4;
    uchar verticalSampling : 4;
    uchar quantTableId;
};

struct SOS_COMPONENT {
    uchar componentSelector;
    uchar dcTableId : 4;
    uchar acTableId : 4;
};

struct DQT_TABLE(int64 end) {
    uchar precision : 4;  // 0 - 8-bit values, 1 - 16-bit
    uchar tableId : 4;
    if (precision == 0 && end - FTell() >= 64)
        uchar quantValues[64] <comment="in zigzag order">;
    else if (precision != 0 && end - FTell() >= 128)
        uint16 quantValues[64] <comment="in zigzag order">;
};

struct DHT_TABLE(int64 end) {
    uchar tableClass : 4;  // 0 - DC, 1 - AC
    uchar tableId : 4;
    if (end - FTell() >= 16) {
        uchar codeCounts[16] <comment="the number of codes of each length 1..16">;
        local int total = 0;
        local int i;
        for (i = 0; i < 16; i++)
            total += codeCounts[i];
        if (total > 0 && total <= end - FTell())
            uchar symbols[total];
    }
};

// How much of the entropy-coded data may still be scanned (bytes): keeps
// the run short on huge files; past it the rest is taken as scan data
local int64 scanBudget = 64 * 1024 * 1024;

// The end of the entropy-coded data that starts at pos: the next FF that
// is not followed by 00 or by RST0..RST7; FileSize() if there is none
int64 ScanEnd(int64 pos) {
    local int64 size = FileSize();
    local int64 p = pos;
    local uint64 w, x;
    local int b;
    while (p < size) {
        if (scanBudget <= 0)
            return size;
        // Eight bytes at a time while none of them is FF
        if (p + 8 <= size) {
            w = ReadUInt64(p);
            x = ~w;
            if (((x - 0x0101010101010101) & ~x & 0x8080808080808080) == 0) {
                p += 8;
                scanBudget -= 8;
                continue;
            }
        }
        if (ReadUByte(p) == 0xFF) {
            if (p + 1 >= size)
                return p;
            b = ReadUByte(p + 1);
            if (b != 0x00 && (b < 0xD0 || b > 0xD7))
                return p;
            p += 2;
            scanBudget -= 2;
        } else {
            p++;
            scanBudget--;
        }
    }
    return size;
}

// Markers without a length
int Standalone(int m) {
    return m == 0xFFD8 || m == 0xFFD9 || m == 0xFF01 || (m >= 0xFFD0 && m <= 0xFFD7);
}

// The SOFn markers (C4 is DHT, C8 JPG, CC DAC)
int IsSOF(int m) {
    return m >= 0xFFC0 && m <= 0xFFCF && m != 0xFFC4 && m != 0xFFC8 && m != 0xFFCC;
}

struct JPEG_SEGMENT {
    JPEG_MARKER marker <format=hex>;
    local int m = marker;
    lastMarker = m;
    if (!Standalone(m) && FileSize() - FTell() >= 2) {
        uint16 length <comment="the size of the segment without the marker, with these 2 bytes">;
        local int64 end = startof(length) + length;
        if (length < 2)
            end = FTell();
        local int truncated = 0;
        if (end > FileSize()) {
            end = FileSize();
            truncated = 1;
        }
        local int64 left = end - FTell();

        if (m == 0xFFE0 && left >= 14 && ReadUInt(FTell()) == 0x4A464946 && ReadUByte(FTell() + 4) == 0) {
            // JFIF: the fields are in the segment itself
            char   identifier[5] <comment="\"JFIF\" 00">;
            uchar  versionMajor;
            uchar  versionMinor;
            JFIF_UNITS units;
            uint16 xDensity;
            uint16 yDensity;
            uchar  xThumbnail <comment="the width of the RGB thumbnail">;
            uchar  yThumbnail;
            local int64 thumb = (int64)xThumbnail * yThumbnail * 3;
            if (thumb > 0 && thumb <= end - FTell())
                uchar thumbnail[thumb] <comment="RGB pixels">;
        } else if (m == 0xFFE0 && left >= 6 && ReadUInt(FTell()) == 0x4A465858 && ReadUByte(FTell() + 4) == 0) {
            char  identifier[5] <comment="\"JFXX\" 00">;
            uchar extensionCode <format=hex, comment="10 - JPEG thumbnail, 11 - 1 byte per pixel, 13 - 3 bytes per pixel">;
        } else if (m == 0xFFE1 && left >= 6 && ReadUInt(FTell()) == 0x45786966 && ReadUShort(FTell() + 4) == 0) {
            EXIF exif(end);
        } else if (m == 0xFFE1 && left >= 29 && ReadUInt(FTell()) == 0x68747470 && ReadUByte(FTell() + 28) == 0) {
            string namespace <comment="XMP: http://ns.adobe.com/xap/1.0/">;
            if (end > FTell())
                char xmp[end - FTell()];
        } else if (m == 0xFFDB) {
            while (end - FTell() >= 65)
                DQT_TABLE table(end);
        } else if (IsSOF(m) && left >= 6) {
            uchar  precision <comment="bits per sample">;
            uint16 height <comment="0 - set by a DNL segment">;
            uint16 width;
            uchar  numComponents;
            if (numComponents > 0 && numComponents * 3 <= end - FTell())
                SOF_COMPONENT component[numComponents];
        } else if (m == 0xFFC4) {
            local int tables = 0;
            while (end - FTell() >= 17 && tables < 32) {
                DHT_TABLE table(end);
                tables++;
            }
        } else if (m == 0xFFDA && left >= 1) {
            uchar numComponents;
            if (numComponents > 0 && numComponents * 2 <= end - FTell())
                SOS_COMPONENT component[numComponents];
            if (end - FTell() >= 3) {
                uchar spectralStart <comment="Ss">;
                uchar spectralEnd <comment="Se">;
                uchar approxHigh : 4;  // Ah
                uchar approxLow : 4;  // Al
            }
        } else if (m == 0xFFDD && left >= 2) {
            uint16 restartInterval <comment="MCUs between RSTn markers, 0 - none">;
        } else if (m == 0xFFDC && left >= 2) {
            uint16 numberOfLines;
        } else if (m == 0xFFFE && left > 0) {
            char comment[left];
        } else if (m >= 0xFFE0 && m <= 0xFFEF && left > 0 && ReadUByte(FTell()) >= 0x20) {
            // APPn: usually an identifier, then data
            local int64 z = FTell();
            while (z < end && z - FTell() < 80 && ReadUByte(z) != 0)
                z++;
            if (z < end && ReadUByte(z) == 0)
                string identifier;
        }
        if (FTell() < end)
            uchar data[end - FTell()];
        FSeek(end);
        if (truncated)
            Warning("the segment at 0x%X is truncated", startof(marker));

        if (m == 0xFFDA && !truncated && FTell() < FileSize()) {
            local int64 scanEnd = ScanEnd(FTell());
            if (scanEnd > FTell())
                uchar scanData[scanEnd - FTell()] <comment="entropy-coded data, with FF 00 and RSTn inside">;
        }
    }
};

string SegmentRead(JPEG_SEGMENT &s) {
    local int m = s.marker;
    local string name = EnumToString(s.marker);
    if (name == "")
        name = Str("FF%02X", m & 0xFF);
    if (IsSOF(m) && exists(s.width))
        return Str("%s %ux%u", name, s.width, s.height);
    if (exists(s.versionMajor))
        return Str("%s JFIF %d.%02d", name, s.versionMajor, s.versionMinor);
    if (exists(s.extensionCode))
        return name + " JFXX";
    if (exists(s.exif))
        return name + " Exif";
    if (exists(s.xmp))
        return name + " XMP";
    if (exists(s.identifier))
        return name + " " + Str("%s", s.identifier);
    if (exists(s.comment))
        return name + " " + Str("%s", s.comment);
    if (exists(s.restartInterval))
        return Str("%s %u", name, s.restartInterval);
    if (exists(s.scanData))
        return Str("%s %d components, %d bytes of data", name, s.numComponents, sizeof(s.scanData));
    if (exists(s.length))
        return Str("%s %u bytes", name, s.length);
    return name;
}

local int lastMarker = 0;
local int segments = 0;
local int done = 0;
while (!FEof() && !done && segments < 100000) {
    if (FileSize() - FTell() < 2 || ReadUByte(FTell()) != 0xFF) {
        // Not a marker: damaged or not JPEG; stop here
        uchar unknownData[FileSize() - FTell()];
        break;
    }
    if (ReadUByte(FTell() + 1) == 0xFF) {
        // Fill bytes before a marker
        local int64 f = FTell();
        while (f + 1 < FileSize() && ReadUByte(f + 1) == 0xFF && f - FTell() < 65536)
            f++;
        uchar fill[f - FTell()] <format=hex, comment="fill bytes FF">;
        continue;
    }
    JPEG_SEGMENT segment <read=SegmentRead>;
    segments++;
    if (lastMarker == 0xFFD9)
        done = 1;
}
if (!FEof())
    uchar trailingData[FileSize() - FTell()] <comment="after EOI">;
